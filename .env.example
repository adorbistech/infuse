# ==============================================================================
# INFUSE — Execution Intelligence: Deployment Configuration Template
# ==============================================================================
# Copy this file to '.env' and adjust settings for your deployment target.
# NEVER commit production secrets or credentials to source control.
# ==============================================================================

# --- Network & Server Binding ---
INFUSE_HOST=0.0.0.0
INFUSE_PORT=8000
INFUSE_ENVIRONMENT=production
INFUSE_LOG_LEVEL=INFO
INFUSE_WORKERS=1

# --- Server Lifecycle & Timeout ---
INFUSE_SHUTDOWN_TIMEOUT_SEC=15.0
INFUSE_MAX_REQUEST_SIZE_BYTES=10485760

# --- Security & CORS ---
# Comma-separated list of allowed origins or '*' for wildcard
INFUSE_CORS_ORIGINS=*

# --- Observability & Probes ---
INFUSE_ENABLE_METRICS=true
INFUSE_ENABLE_READINESS_PROBE=true

# --- Optional MCP Sidecar Server ---
INFUSE_MCP_SERVER_ENABLED=false
INFUSE_MCP_SERVER_PORT=8001

# --- Persistence Boundary ---
# Storage backend: 'inmemory' (default) or 'filesystem'
INFUSE_STORAGE_BACKEND=inmemory
INFUSE_STORAGE_PATH=

# --- Optional External Provider Keys (Injected securely at runtime) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
